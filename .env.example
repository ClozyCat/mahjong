# Compose project name shown by Docker
COMPOSE_PROJECT_NAME=mahjong

# Public port exposed by the frontend container
APP_PORT=80

# Default persistent SQLite database file
MAHJONG_DATABASE_URL=sqlite+pysqlite:////data/mahjong.db

# Host directory mounted to /data in the backend container.
# Set this to a directory on the external hard drive in production.
MAHJONG_DATA_DIR=/opt/mahjong-data

# Prebuilt image tags used by docker-compose.prebuilt.yml
BACKEND_IMAGE=mahjong-backend:latest
FRONTEND_IMAGE=mahjong-frontend:latest

# PostgreSQL example:
# MAHJONG_DATABASE_URL=postgresql+psycopg://mahjong:change-me@postgres:5432/mahjong

# Spectator mode is always enabled and no longer needs a feature flag.

# ONNX Runtime version downloaded into the backend Docker image.
ONNXRUNTIME_VERSION=1.24.2

# BOT policy:
# - heuristic: rule/search-only BOT
# - neural: v2 multi-head neural BOT with legal masks
MAHJONG_BOT_POLICY=neural
MAHJONG_BOT_MODEL_PATH=/app/assets/models/mahjong_policy_net.onnx
MAHJONG_BOT_STRENGTH=strong
